  <summary>▸ Raw ntpq -p -n output</summary>
  <div class="raw">{raw}</div>
</details>
<div class="footer">rpi4 · ntp-monitor v1.0 · history stored at /var/lib/ntp-monitor/history.json</div>
</body></html>'''


def main():
    os.makedirs(os.path.dirname(HISTORY_FILE), exist_ok=True)
    os.makedirs(os.path.dirname(OUTPUT_FILE),  exist_ok=True)

    history = []
    if os.path.exists(HISTORY_FILE):
        try:
            with open(HISTORY_FILE) as f:
                history = json.load(f)
        except Exception:
            history = []

    raw   = run_ntpq()
    peers = parse_ntpq(raw)
    sel   = selected(peers)

    history.append({
        'ts':          datetime.now(timezone.utc).isoformat(),
        'peer_count':  len(peers),
        'good_count':  sum(1 for p in peers if p['status'] in ('*', '+')),
        'sel_remote':  sel['remote']  if sel else None,
        'sel_offset':  sel['offset']  if sel else None,
        'sel_st':      sel['st']      if sel else None,
        'sel_jitter':  sel['jitter']  if sel else None,
    })
    history = history[-MAX_HISTORY:]

    with open(HISTORY_FILE, 'w') as f:
        json.dump(history, f)

    alerts = detect_anomalies(peers, history)
    html   = generate_html(peers, history, alerts, raw)

    import shutil
    with open(OUTPUT_FILE, "w") as f:
        f.write(html)


if __name__ == '__main__':
    main()

