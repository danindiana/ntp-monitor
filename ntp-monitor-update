.ok{{background:#001a08;border-left:3px solid #00e676;padding:8px 14px;border-radius:4px;color:#69f0ae;margin-bottom:14px}}
.selbar{{background:#0f1923;border-radius:4px;padding:8px 14px;margin-bottom:14px;display:flex;gap:14px;flex-wrap:wrap;align-items:center}}
